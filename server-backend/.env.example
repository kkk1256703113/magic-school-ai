# 环境配置
NODE_ENV=production

# 服务器配置
PORT=3001
HOST=0.0.0.0

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eduvisualizer_db
DB_USER=eduvisualizer_user
DB_PASS=EduViz2025Secure

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://45.77.86.20

# 速率限制
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# API密钥（如果需要）
OPENAI_API_KEY=
CLAUDE_API_KEY=
REPLICATE_API_KEY=

# 日志级别
LOG_LEVEL=info

# 文件上传限制
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,txt,md,docx,png,jpg,jpeg

# 会话配置
SESSION_SECRET=your-session-secret-change-this
SESSION_MAX_AGE=86400000

# 邮件配置（如果需要）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@magic-school-ai.com

# Redis配置（如果使用）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 监控配置
ENABLE_MONITORING=true
MONITORING_INTERVAL=60000